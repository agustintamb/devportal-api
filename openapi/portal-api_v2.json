            "schema": {
              "enum": [
                "success",
                "error",
                "pending"
              ],
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Número de página, desde 1. Por defecto, 1.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Cantidad de ítems por página, entre 1 y 100. Por defecto, 20.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta correcta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfActivityDto"
                }
              }
            }
          },
          "400": {
            "description": "El parámetro `status` no es success, error ni pending, o `page` o `pageSize` están fuera de rango o no son números (`validation_error`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token de acceso o no es válido (`unauthorized`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "El token es de un cliente OAuth y sus scopes no cubren este endpoint (`forbidden`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": [ ]
          }
        ]
      }
    },
